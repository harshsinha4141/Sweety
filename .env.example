# Docker Compose settings (copy to .env next to docker-compose.yml).
# Used by `docker compose`, not by `npm run dev` (that still reads backend/.env).

# Postgres password - also used by PostgREST in a connection URL, so use letters/digits only.
POSTGRES_PASSWORD=
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
DEFAULT_TIMEZONE=Asia/Kolkata
REPORTS_CACHE_TTL_SECONDS=3600

# Host ports (change if something else already uses them)
FRONTEND_PORT=8088
BACKEND_PORT=3000
POSTGRES_PORT=5432
