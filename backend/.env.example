PORT=3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Fallback IANA time zone for "today" when the client sends no X-Timezone header
DEFAULT_TIMEZONE=Asia/Kolkata

# Redis cache for reports (optional — leave empty to turn caching off).
# Local: redis://localhost:6379   Hosted (e.g. Upstash/Redis Cloud): rediss://default:<password>@<host>:<port>
REDIS_URL=
# How long a cached report lives, in seconds (it is also cleared whenever a reading changes)
REPORTS_CACHE_TTL_SECONDS=3600

# Allowed frontend origins for CORS (comma-separated, no trailing slash)
FRONTEND_URL=http://localhost:5173,https://sweety-frontend.vercel.app
